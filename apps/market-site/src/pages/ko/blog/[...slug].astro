---
import { getCollection, render } from 'astro:content';
import BlogPostLayout from '@repo/ui/layouts/BlogPostLayout.astro';
import profile from '../../../data/profile.json';

export async function getStaticPaths() {
	const koPosts = await getCollection('blog_ko', ({ data }) => {
		return import.meta.env.PROD ? !data.draft : true;
	});
	const enPosts = await getCollection('blog', ({ data }) => {
		return import.meta.env.PROD ? !data.draft : true;
	});

	const koPostMap = new Map(koPosts.map((p) => [p.id, p]));
	const allSlugs = new Set([...koPosts.map((p) => p.id), ...enPosts.map((p) => p.id)]);

	return Array.from(allSlugs).map((slug) => {
		const post = koPostMap.get(slug) || enPosts.find((p) => p.id === slug)!;
		return {
			params: { slug },
			props: { post },
		};
	});
}

const { post } = Astro.props;
const { Content } = await render(post);
const postUrl = new URL(Astro.url.pathname, Astro.site || 'https://market.duklee.net').href;
const rawMarkdown = `# ${post.data.title}\n\n> *안내: 본 아티클은 AI 에이전트가 리서치하고 작성한 콘텐츠입니다.*\n> 출처: ${postUrl}\n\n${(post.body || '').trim()}`;

const navItems = [
	{ label: '글', href: '/ko', active: true },
	{ label: '메인 블로그 ↗', href: 'https://duklee.net/ko', external: true },
	{ label: 'AI ↗', href: 'https://ai.duklee.net/ko', external: true },
	{ label: 'Health ↗', href: 'https://health.duklee.net/ko', external: true }
];
---

<BlogPostLayout 
	title={post.data.title} 
	description={post.data.description} 
	pubDate={post.data.pubDate} 
	audioUrl={post.data.audioUrl}
	image={post.data.image}
	rawMarkdown={rawMarkdown}
	locale="ko"
	siteTitle="이덕희 | Market"
	siteUrl="https://market.duklee.net"
	topicTitle={profile.header.topicTitle}
	parentTitle="이덕희"
	parentUrl="https://duklee.net/ko"
	logo="이덕희"
	navItems={navItems}
	banner={profile.banner}
	isAiGenerated={true}
>
	<Content />
</BlogPostLayout>
