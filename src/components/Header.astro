---
import { useTranslations, type SupportedLanguage, getLocalizedPath } from '../i18n/ui';

export interface NavItem {
	label: string;
	href: string;
	active?: boolean;
	external?: boolean;
}

interface Props {
	logo?: string;
	topicTitle?: string;
	parentTitle?: string;
	parentUrl?: string;
	locale?: SupportedLanguage;
	navItems?: NavItem[];
}

const { 
	logo, 
	topicTitle, 
	parentTitle, 
	parentUrl, 
	locale, 
	navItems 
} = Astro.props;

const pathname = Astro.url.pathname;
const currentLocale: SupportedLanguage = locale || (Astro.currentLocale as SupportedLanguage) || (pathname.startsWith('/ko') ? 'ko' : pathname.startsWith('/zh') ? 'zh' : 'en');
const t = useTranslations(currentLocale);

const isKo = currentLocale === 'ko';
const isZh = currentLocale === 'zh';
const displayLogo = (!logo || logo === 'Duk Lee' || logo === '이덕희' || logo === '李德熙') ? t('site.title') : logo;
const defaultParentTitle = parentTitle || (isKo ? '이덕희' : isZh ? '李德熙' : 'Duk Lee');

const homeUrl = isKo ? '/ko' : isZh ? '/zh' : '/';
const nakseojangUrl = isKo ? '/ko/nakseojang' : isZh ? '/zh/nakseojang' : '/nakseojang';
const libraryUrl = isKo ? '/ko/library' : isZh ? '/zh/library' : '/library';

// Check active states for default nav
const isHome = isKo 
	? (pathname === '/ko' || pathname === '/ko/' || pathname.match(/^\/ko\/\d+$/) !== null)
	: isZh
	? (pathname === '/zh' || pathname === '/zh/' || pathname.match(/^\/zh\/\d+$/) !== null)
	: (pathname === '/' || pathname === '/1' || pathname.match(/^\/\d+$/) !== null);

const isLibrary = pathname.startsWith('/library') || pathname.startsWith('/ko/library') || pathname.startsWith('/zh/library');
const isNakseojang = pathname.startsWith('/nakseojang') || pathname.startsWith('/ko/nakseojang') || pathname.startsWith('/zh/nakseojang');

// Localized language switch targets
const enUrl = getLocalizedPath(pathname, 'en');
const koUrl = getLocalizedPath(pathname, 'ko');
const zhUrl = getLocalizedPath(pathname, 'zh');
---

<header>
	{topicTitle ? (
		<div class="logo-wrapper">
			{parentUrl ? (
				<a href={parentUrl} class="logo-parent">{defaultParentTitle}</a>
			) : (
				<span class="logo-parent">{defaultParentTitle}</span>
			)}
			<span class="logo-sep">/</span>
			<a href={homeUrl} class="logo-topic">{topicTitle}</a>
		</div>
	) : (
		<a href={homeUrl} class="logo">{displayLogo}</a>
	)}
	<nav>
		{navItems ? (
			navItems.map((item) => (
				<a 
					href={item.href} 
					class={item.active ? 'active' : ''} 
					target={item.external ? '_blank' : undefined}
					rel={item.external ? 'noopener noreferrer' : undefined}
				>
					{item.label}
				</a>
			))
		) : (
			<>
				<a href={homeUrl} class={isHome ? 'active' : ''}>{t('nav.writing')}</a>
				<a href={nakseojangUrl} class={isNakseojang ? 'active' : ''}>{t('nav.nakseojang')}</a>
				<a href={libraryUrl} class={isLibrary ? 'active' : ''}>{t('nav.library')}</a>
			</>
		)}
		<div class="lang-switch-wrapper">
			<div class="lang-switch-btn">
				<a href={enUrl} class={currentLocale === 'en' ? 'active-lang' : 'inactive-lang'} title="Switch to English">EN</a>
				<span class="lang-separator">/</span>
				<a href={koUrl} class={currentLocale === 'ko' ? 'active-lang' : 'inactive-lang'} title="한국어로 전환">KO</a>
				<span class="lang-separator">/</span>
				<a href={zhUrl} class={currentLocale === 'zh' ? 'active-lang' : 'inactive-lang'} title="切换至中文">ZH</a>
			</div>
		</div>
	</nav>
</header>

<style>
	.logo-wrapper {
		display: inline-flex;
		align-items: baseline;
		gap: 8px;
		font-family: var(--font-serif);
		font-size: 30px;
		line-height: 1;
	}

	.logo-parent {
		color: var(--text-muted);
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.logo-parent:hover {
		color: var(--text-color);
		text-decoration: underline;
	}

	.logo-sep {
		color: var(--text-muted);
		opacity: 0.4;
		font-weight: 300;
		user-select: none;
	}

	.logo-topic {
		color: var(--text-color);
		font-weight: 600;
		text-decoration: none;
	}

	.logo-topic:hover {
		text-decoration: underline;
	}

	.lang-switch-wrapper {
		margin-left: 8px;
		display: inline-flex;
		align-items: center;
	}

	.lang-switch-btn {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		font-family: var(--font-mono);
		font-size: 12px;
		text-decoration: none !important;
		padding: 3px 8px;
		border-radius: 4px;
		border: 1px solid var(--border-color);
		background-color: var(--card-bg);
		color: var(--text-color);
		transition: all 0.2s ease;
	}

	.lang-switch-btn:hover {
		border-color: var(--underline-hover);
		background-color: rgba(0, 0, 0, 0.06);
	}

	.lang-switch-btn a {
		color: inherit;
		text-decoration: none !important;
	}

	.lang-switch-btn a:hover {
		text-decoration: underline !important;
	}

	.active-lang {
		font-weight: 700;
		color: var(--text-color);
	}

	.inactive-lang {
		color: var(--text-muted);
		opacity: 0.6;
	}

	.lang-separator {
		color: var(--text-muted);
		opacity: 0.4;
		font-size: 11px;
	}

	@media (max-width: 640px) {
		header {
			flex-direction: column;
			gap: 16px;
			align-items: flex-start;
		}

		nav {
			gap: 18px;
			flex-wrap: wrap;
			align-items: center;
			width: 100%;
		}

		.lang-switch-wrapper {
			margin-left: auto;
		}
	}
</style>
